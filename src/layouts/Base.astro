---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rua das Vitrines — Landing pages para negócio de verdade',
  description = 'Portfólio de landing pages feitas do zero para negócios reais — barbearia, petshop, fotógrafa, veterinária, marmitaria e mais. Veja como ficaria a página do seu negócio.',
} = Astro.props;

const siteUrl = 'https://vitrine-landing-pages-six.vercel.app';
const waLink = `https://wa.me/5511997978901?text=Ol%C3%A1%2C%20Leonardo!%20Vi%20seu%20portf%C3%B3lio%20no%20Rua%20das%20Vitrines.%20Gostaria%20de%20ver%20uma%20pr%C3%A9via%20sem%20compromisso%20para%20o%20meu%20neg%C3%B3cio`;
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>

  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content="8 páginas feitas do zero para negócios reais. Veja os projetos e descubra como ficaria a sua.">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:image" content={`${siteUrl}/og-image.png`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content="8 páginas feitas do zero para negócios reais. Veja os projetos e descubra como ficaria a sua.">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --bg:      #FAFAF8;
      --ink:     #161614;
      --ink-2:   #6B6860;
      --ink-3:   #A8A49E;
      --accent:  #C4781A;
      --line:    rgba(22,22,20,0.08);
      --card-bg: #FFFFFF;
      --dark-bg: #161614;
      --dark-fg: #F5F4F0;
      --r:       14px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
      line-height: 1.5;
    }

    .wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 clamp(20px, 5vw, 56px);
    }

    h1, h2, h3 { font-family: "Fraunces", Georgia, serif; margin: 0; }

    /* ─── Header ───────────────────────────────────── */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(250,250,248,0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
    }
    .logo {
      font-family: "Fraunces", serif;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
    }
    .logo em { font-style: normal; color: var(--accent); }
    .btn-hire {
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
      padding: 8px 18px;
      border: 1.5px solid rgba(22,22,20,0.18);
      border-radius: 100px;
      transition: background .15s, color .15s, border-color .15s;
    }
    .btn-hire:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }

    /* ─── Buttons ───────────────────────────────────── */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      padding: 13px 24px;
      border-radius: 100px;
      background: var(--accent);
      color: #fff;
      text-decoration: none;
      transition: opacity .15s;
      white-space: nowrap;
    }
    .btn-primary:hover { opacity: .86; }
    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      font-size: 0.88rem;
      padding: 10px 20px;
      border-radius: 100px;
      border: 1.5px solid rgba(22,22,20,0.18);
      color: var(--ink);
      text-decoration: none;
      transition: background .15s, color .15s, border-color .15s;
    }
    .btn-outline:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }

    /* ─── Card ──────────────────────────────────────── */
    .card {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      background: var(--card-bg);
      border-radius: var(--r);
      overflow: hidden;
      border: 1px solid var(--line);
      transition: box-shadow .22s ease, transform .22s ease;
    }
    .card:hover {
      box-shadow: 0 20px 56px -18px rgba(22,22,20,0.2);
      transform: translateY(-3px);
    }
    .card-img {
      aspect-ratio: 16/10;
      overflow: hidden;
      background: #E8E6E1;
      flex-shrink: 0;
    }
    .card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transition: transform .4s ease;
    }
    .card:hover .card-img img { transform: scale(1.05); }
    .card-info {
      padding: 18px 20px 22px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }
    .card-tag {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .card-name {
      font-family: "Fraunces", serif;
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--ink);
      line-height: 1.2;
    }
    .card-desc {
      font-size: 0.84rem;
      color: var(--ink-2);
      line-height: 1.55;
      margin: 4px 0 0;
    }
    .card-link {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--ink);
      margin-top: auto;
      padding-top: 14px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: gap .15s;
    }
    .card:hover .card-link { gap: 9px; }

    /* ─── Featured card ─────────────────────────────── */
    .card--hero { flex-direction: row; }
    .card--hero .card-img {
      aspect-ratio: auto;
      flex: 0 0 58%;
      min-height: 300px;
    }
    .card--hero .card-info {
      padding: 44px 52px;
      justify-content: center;
      gap: 10px;
    }
    .card--hero .card-name {
      font-size: 2.4rem;
      letter-spacing: -0.025em;
      line-height: 1.05;
    }
    .card--hero .card-desc {
      font-size: 0.96rem;
      max-width: 34ch;
      margin-top: 8px;
    }

    /* ─── Footer ────────────────────────────────────── */
    footer {
      background: var(--dark-bg);
      border-top: 1px solid rgba(245,244,240,0.08);
      padding: 20px 0 32px;
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.74rem;
      color: rgba(245,244,240,0.45);
    }
  </style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="header-inner">
      <span class="logo">Rua das <em>Vitrines</em></span>
      <a class="btn-hire" href={waLink} target="_blank" rel="noopener">Contratar →</a>
    </div>
  </div>
</header>

<main>
  <slot />
</main>

<footer>
  <div class="wrap">
    <div class="footer-inner">
      <span>Rua das Vitrines — catálogo de projetos</span>
      <span>Atualizado em 2026</span>
    </div>
  </div>
</footer>

</body>
</html>
